{
  "required": true,
  "minVersion": "0.8",
  "package": "cedclient.mixin",
  "compatibilityLevel": "JAVA_25",

  "mixins": [
    "ClientPacketListenerMixin",

    "EntityMixin",
    "LevelRendererMixin",
    "MultiPlayerGameModeMixin",

    "ContainerEventHandlerMixin",
    "AbstractContainerScreenMixin",
    "AbstractContainerScreenAccessor",
    "CameraAccessor",
    "CameraMixin",
    "KeyboardInputMixin",
    "ClientInputAccessor",
    "MinecraftTurnMixin"
  ],

  "client": [
    "MinecraftMixin",
    "GuiMixin"
  ],

  "injectors": {
    "defaultRequire": 1
  },

  "overwrites": {
    "requireAnnotations": true
  }
}